# Copy this file to .env and replace the placeholder values before deployment.
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgresql://eis_user:replace-me@localhost:5432/eis_assignment
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
DJANGO_SECURE_SSL_REDIRECT=True
# Set this to 0 only when TLS is not configured at the deployment edge.
DJANGO_SECURE_HSTS_SECONDS=31536000
# Enable only after confirming every subdomain is HTTPS-only and eligible for preload.
DJANGO_SECURE_HSTS_PRELOAD=False
# Set to True only when a trusted reverse proxy passes X-Forwarded-Proto.
DJANGO_BEHIND_PROXY=False
POSTGRES_DB=eis_assignment
POSTGRES_USER=eis_user
POSTGRES_PASSWORD=replace-me
